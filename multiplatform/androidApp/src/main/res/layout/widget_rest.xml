<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">
    <TextView
        android:id="@+id/rest_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="@color/widget_text_primary"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium" android:gravity="center" />
    <TextView
        android:id="@+id/rest_enjoy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="15sp"
        android:textColor="@color/widget_text_secondary"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:fontFamily="sans-serif-medium" android:layout_marginTop="4dp" android:gravity="center" android:text="Enjoy🎉" />
    <TextView
        android:id="@+id/rest_next"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/widget_text_secondary"
        android:maxLines="1"
        android:ellipsize="end"
        android:includeFontPadding="false"
        android:layout_marginTop="6dp" android:gravity="center" android:visibility="gone" />
</LinearLayout>
